# URL of the Navidrome dev server
TEST_BASE_URL=http://localhost:4533

# Primary test user (non-admin recommended for FR-01 isolation check)
TEST_USER=admin
TEST_PASSWORD=admin

# Admin credentials — used in FR-01 to create a playlist that TEST_USER should NOT see.
# Set to a different user than TEST_USER to enable the cross-user isolation assertion.
# If equal to TEST_USER, the isolation assertion is skipped (no second user available).
ADMIN_USER=admin
ADMIN_PASSWORD=admin
