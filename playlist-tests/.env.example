# URL del servidor Navidrome
TEST_BASE_URL=http://localhost:4533

# Usuario de prueba principal (recomendado: NO admin, para que FR-01 sea significativo)
# Créalo manualmente en Navidrome: Settings > Users > Create
TEST_USER=testuser
TEST_PASSWORD=testpass

# Credenciales del admin (para crear playlists que TEST_USER NO debería ver en FR-01)
# Si TEST_USER == ADMIN_USER, la comprobación de aislamiento de FR-01 se omite
ADMIN_USER=admin
ADMIN_PASSWORD=admin
